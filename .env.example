# Convertway API Configuration
CONVERTWAY_API_BASE_URL=https://app.theconvertway.com/api/v1
CONVERTWAY_LICENSE_KEY=cw_your_license_key_here

# MCP Server Settings
# Transport mode: "stdio" (default, for local CLI integration) or "http" (for remote/server mode)
MCP_TRANSPORT=http
# Port for HTTP server (used when MCP_TRANSPORT=http)
MCP_PORT=3000
# MCP Streamable HTTP endpoint path
MCP_PATH=/mcp
# Webhook callback path for Convertway
WEBHOOK_PATH=/webhooks/convertway

# Email (SMTP) — fallback direct sending
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
SMTP_FROM=noreply@yourdomain.com

# Storage
CONVERSATIONS_DB_PATH=./data/conversations.json
