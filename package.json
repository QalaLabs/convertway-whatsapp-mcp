{
  "name": "convertway-whatsapp-mcp",
  "version": "1.0.0",
  "description": "MCP Server for WhatsApp Business API via Convertway by Unicommerce — omnichannel communication layer",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "convertway-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "cross-env MCP_TRANSPORT=http MCP_PORT=3000 node dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:http": "cross-env MCP_TRANSPORT=http tsx src/index.ts",
    "watch": "tsx watch src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.18.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.0",
    "cross-env": "^10.1.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "mcp",
    "whatsapp",
    "convertway",
    "unicommerce",
    "omnichannel",
    "whatsapp-business-api",
    "sms",
    "email"
  ]
}
